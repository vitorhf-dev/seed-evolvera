{
  "name": "@evolvera/industrial-site-seed",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent six-page static industrial website blueprint",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "npm run test:structure && npm run test:browser",
    "test:structure": "node --test --test-concurrency=1 tests/structure.test.mjs tests/server.test.mjs",
    "test:server": "node --test --test-concurrency=1 tests/server.test.mjs",
    "test:browser": "node --max-old-space-size=768 --test --test-concurrency=1 tests/browser-foundation.test.mjs tests/browser-interactions.test.mjs",
    "test:interactions": "node --max-old-space-size=768 --test --test-concurrency=1 tests/browser-interactions.test.mjs",
    "check": "npm run test:structure && npm run test:browser"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}

  "runtime": {
    "entry": "scripts/main.js",
    "enhancements": [
      "mobile-nav",
      "scroll-lock",
      "catalog-filter",
      "gallery-dialog",
      "faq-details",
      "safe-reveal",
      "local-video",
      "inquiry-form"
    ],
    "fallbacks": [
      "native details navigation",
      "authored catalog cards remain visible",
      "local linked gallery images",
      "native details FAQ",
      "static content remains visible",
      "direct inquiry channels and preserved values"
    ],
    "invariants": [
      "dependency-free ES modules",
      "owned local scripts only",
      "fail-open progressive enhancement",
      "no transport/navigation/storage/analytics",
      "no fake submission result"
    ]
  },
  "mediaContracts": {
    "modes": {
      "media-rich": "Optional verified local media fills the prescribed component region when supplied, with factual dimensions and context.",
      "media-light": "Optional verified local media appears as a contained, captioned inset plate; it never becomes a requirement for the page.",
      "no-media": "Canonical media-free mode: no media column is reserved; the editorial index rail carries the copy-first composition, and failed media collapses back to it without an empty frame."
    },
    "heroVariants": [
      "image",
      "local-video",
      "product-or-diagram",
      "editorial-no-media"
    ],
    "defaultHeroVariant": "editorial-no-media",
    "missingAssetFallback": "no-media"
  }
}
